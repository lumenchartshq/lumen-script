{
  "name": "@lumencharts/script",
  "version": "0.1.1",
  "description": "Lumen Script: a browser-safe engine that compiles and runs Pine Script® v5 and v6 indicators and strategies bar by bar.",
  "license": "AGPL-3.0-only",
  "homepage": "https://docs.lumencharts.com/charting-library/studies/lumen-script",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumenchartshq/lumen-script.git"
  },
  "bugs": {
    "url": "https://github.com/lumenchartshq/lumen-script/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node scripts/verify-browser-bundle.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  }
}
